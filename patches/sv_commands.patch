diff --git a/ramulator2/verify_attention_sv.py b/ramulator2/verify_attention_sv.py
new file mode 100644
--- /dev/null
+++ b/ramulator2/verify_attention_sv.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Verify the fixed 34-token QK -> SFM -> SV example, without numerical data."""
+
+import argparse
+from collections import Counter
+import csv
+from pathlib import Path
+import re
+import sys
+
+
+COUNTS = Counter({"PIM_WR_GB": 16, "PIM_MAC_AB": 12, "PIM_MV_SB": 48,
+                  "PIM_SFM": 2, "PIM_MV_GB": 16, "PIM_BARRIER": 18})
+CHANNELS = (2, 5)
+VALUE_ROW = 8192
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def decode(address):
+    require(0 <= address < 1 << 34, "address outside the fixed example geometry")
+    remaining = address >> 5
+    coordinates = []
+    for bits in reversed((4, 1, 1, 2, 2, 14, 5)):
+        coordinates.append(remaining & ((1 << bits) - 1))
+        remaining >>= bits
+    return tuple(reversed(coordinates)) + (address & 31,)
+
+
+def entry(opcode, channel, *, rank=0, bg=0, bank=0, row=0, column=0, slot=0):
+    return opcode, (channel, 0, rank, bg, bank, row, column, slot)
+
+
+def phases(channel):
+    qk_columns = range(4) if channel == 2 else range(2)
+    sv_columns = (0, 2) if channel == 2 else (0,)
+    context_output = [entry("PIM_MV_SB", channel, rank=rank, bank=bank, row=VALUE_ROW)
+                      for bank in range(4) for rank in range(2)]
+    return [
+        [entry("PIM_WR_GB", channel, bank=bank, slot=slot)
+         for bank in range(4) for slot in range(2)],
+        [entry("PIM_MAC_AB", channel, column=column) for column in qk_columns],
+        [entry("PIM_MV_SB", channel, rank=rank, bg=bg)
+         for bg in range(4) for rank in range(2)],
+        [entry("PIM_SFM", channel)],
+        [entry("PIM_MV_GB", channel, rank=rank, bg=bg, row=VALUE_ROW)
+         for rank in range(2) for bg in range(4)],
+        [entry("PIM_MAC_AB", channel, row=VALUE_ROW, column=column)
+         for column in sv_columns],
+        context_output,
+        [entry("PIM_MAC_AB", channel, row=VALUE_ROW, column=column + 1)
+         for column in sv_columns],
+        context_output,
+    ]
+
+
+def verify_trace(path):
+    counts = Counter()
+    groups = {channel: [] for channel in CHANNELS}
+    current = {channel: [] for channel in CHANNELS}
+    for number, line in enumerate(path.read_text().splitlines(), 1):
+        fields = line.split()
+        require(len(fields) == 2, f"trace line {number}: expected two fields")
+        opcode, raw_address = fields
+        require(opcode in COUNTS, f"trace line {number}: unexpected opcode")
+        require(re.fullmatch(r"0[xX][0-9a-fA-F]+", raw_address), "invalid hexadecimal address")
+        coordinates = decode(int(raw_address, 16))
+        channel = coordinates[0]
+        require(channel in CHANNELS, "unexpected channel")
+        counts[opcode] += 1
+        if opcode == "PIM_BARRIER":
+            require(coordinates[1:] == (0,) * 7, "noncanonical barrier address")
+            require(current[channel], "empty phase before barrier")
+            groups[channel].append(current[channel])
+            current[channel] = []
+        else:
+            current[channel].append((opcode, coordinates))
+    require(counts == COUNTS, f"unexpected request counts: {dict(counts)}")
+    for channel in CHANNELS:
+        require(not current[channel], "missing final output boundary")
+        expected = phases(channel)
+        require(len(groups[channel]) == len(expected), f"channel {channel}: phase count")
+        for index, (actual, wanted) in enumerate(zip(groups[channel], expected)):
+            require(Counter(actual) == Counter(wanted),
+                    f"channel {channel}: trace phase {index} has wrong operations/addresses")
+
+
+def verify_stats(path):
+    content = path.read_text()
+    expected = {
+        "total_num_pim_write_to_gemv_buffer_requests": 16,
+        "total_num_pim_mac_all_bank_requests": 12,
+        "total_num_pim_move_to_softmax_buffer_requests": 48,
+        "total_num_pim_move_to_gemv_buffer_requests": 16,
+        "total_num_pim_softmax_requests": 2,
+        "total_num_read_requests": 0,
+        "total_num_write_requests": 0,
+    }
+    for key, value in expected.items():
+        matches = re.findall(rf"^\s*{re.escape(key)}\s*:\s*(\d+)\s*$", content, re.MULTILINE)
+        require(len(matches) == 1 and int(matches[0]) == value,
+                f"statistic {key}: expected one occurrence with value {value}")
+    cycles = re.findall(r"^\s*memory_system_cycles\s*:\s*(\d+)\s*$", content, re.MULTILINE)
+    require(len(cycles) == 1 and int(cycles[0]) > 0, "missing/zero memory_system_cycles")
+    return int(cycles[0])
+
+
+def verify_logs(prefix):
+    # Issued command names differ from the frontend's trace spellings.
+    names = {"WRGB": "PIM_WR_GB", "MACAB": "PIM_MAC_AB", "MVSB": "PIM_MV_SB",
+             "MVGB": "PIM_MV_GB", "SFM": "PIM_SFM"}
+    for channel in range(16):
+        path = Path(f"{prefix}.ch{channel}")
+        issued = []
+        previous_cycle = -1
+        with path.open(newline="") as handle:
+            for number, fields in enumerate(csv.reader(handle), 1):
+                require(len(fields) == 9, f"{path}:{number}: expected nine CSV fields")
+                cycle = int(fields[0].strip())
+                command = fields[1].strip()
+                coordinates = tuple(int(field.strip()) for field in fields[2:])
+                require(cycle >= previous_cycle, f"{path}:{number}: cycle went backwards")
+                require(coordinates[0] == channel, "channel/log-file mismatch")
+                previous_cycle = cycle
+                if command in names:
+                    issued.append((names[command], coordinates))
+                require(command not in ("MACSB", "MACPB", "SETM", "SETH"),
+                        f"unexpected PIM command: {command}")
+        expected = phases(channel) if channel in CHANNELS else []
+        offset = 0
+        for index, wanted in enumerate(expected):
+            wanted_without_byte_offset = [(opcode, coords[:-1]) for opcode, coords in wanted]
+            actual = issued[offset:offset + len(wanted)]
+            require(Counter(actual) == Counter(wanted_without_byte_offset),
+                    f"channel {channel}: issued phase {index} mismatch/order violation")
+            offset += len(wanted)
+        require(offset == len(issued), f"channel {channel}: extra issued PIM commands")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--trace", type=Path, required=True)
+    parser.add_argument("--stats", type=Path)
+    parser.add_argument("--log-prefix", type=Path)
+    args = parser.parse_args()
+    if (args.stats is None) != (args.log_prefix is None):
+        parser.error("--stats and --log-prefix must be supplied together")
+    try:
+        verify_trace(args.trace)
+        print("PASS: 112 requests = 44 QK + 2 SFM + 66 SV; channels 2/5; V rows and phase order")
+        if args.stats is not None:
+            cycles = verify_stats(args.stats)
+            verify_logs(args.log_prefix)
+            print(f"PASS: accepted/issued commands and QK -> SFM -> SV order; memory_system_cycles={cycles}")
+        else:
+            print("Trace-only check. Ramulator execution and final attention latency are not verified.")
+    except (OSError, ValueError) as error:
+        print(f"FAIL: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
