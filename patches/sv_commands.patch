diff --git a/pim_ramulator_src/tier_runtime/include/sv_command.h b/pim_ramulator_src/tier_runtime/include/sv_command.h
new file mode 100644
--- /dev/null
+++ b/pim_ramulator_src/tier_runtime/include/sv_command.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "pim_command.h"
+
+namespace Ramulator::TierRuntime {
+
+// One query head's SV. V is selected by layer/KV head; its probabilities
+// belong to the query head currently scheduled by the caller.
+struct SVCommandInput {
+    std::uint64_t layer_index = 0;
+    std::uint64_t kv_head_index = 0;
+    std::uint64_t valid_token_count = 0;
+    std::vector<int> allocated_channel_ids;
+    std::uint64_t initial_channel_count = 0;
+};
+
+// Trace commands and the channels that contributed to the partial result.
+struct SVCommandBatch {
+    std::vector<PIMCommand> commands;
+    std::vector<int> active_channel_ids;
+};
+
+} // namespace Ramulator::TierRuntime
diff --git a/pim_ramulator_src/tier_runtime/pim_command_generator_sv.cpp b/pim_ramulator_src/tier_runtime/pim_command_generator_sv.cpp
new file mode 100644
--- /dev/null
+++ b/pim_ramulator_src/tier_runtime/pim_command_generator_sv.cpp
@@ -0,0 +1,178 @@
+#include "pim_command_generator.h"
+
+#include <algorithm>
+#include <cstddef>
+
+namespace Ramulator::TierRuntime {
+namespace {
+// AttAcc Sec. 5.1: 16 x 256-bit input slots per resident buffer.
+// A slot contains 16 FP16 weights; double buffering is not extra capacity
+// for one resident vector. This schedule does not overlap buffer refills.
+constexpr std::size_t sv_input_slot_count = 16;
+
+std::uint64_t sv_ceil_div(std::uint64_t value, std::uint64_t divisor) {
+    return value / divisor + (value % divisor != 0);
+}
+} // namespace
+
+std::uint64_t PIMCommandGenerator::encode_probability_buffer(
+    int channel_id, std::uint64_t rank, std::uint64_t bank_group,
+    std::uint64_t slot, std::uint64_t value_slice_base_row
+) const {
+    // context_cpvec(): the slot is a raw low address, not slot * 32.
+    return m_encoder.encode(AttAccAddressCoordinates{
+        channel_id, 0, rank, bank_group, 0, value_slice_base_row, 0, slot
+    });
+}
+
+std::uint64_t PIMCommandGenerator::encode_context_buffer(
+    int channel_id, std::uint64_t rank, std::uint64_t bank,
+    std::uint64_t value_slice_base_row
+) const {
+    return m_encoder.encode(AttAccAddressCoordinates{
+        channel_id, 0, rank, 0, bank, value_slice_base_row, 0, 0
+    });
+}
+
+SVCommandBatch PIMCommandGenerator::generate_sv(const SVCommandInput& input) const {
+    validate_allocation(input.allocated_channel_ids, input.initial_channel_count);
+    const auto value_base_row = m_layout.slice_base_row(
+        KVKind::Value, input.layer_index, input.kv_head_index
+    ); // Validate the slice even for an empty operation.
+    const auto tokens_per_block = m_layout.tokens_per_block();
+    const auto block_count = sv_ceil_div(input.valid_token_count, tokens_per_block);
+    if (block_count != 0) {
+        (void)m_address_mapper.locate_mac(
+            KVKind::Value, input.layer_index, input.kv_head_index,
+            block_count - 1, 0,
+            input.allocated_channel_ids, input.initial_channel_count
+        ); // Reject insufficient allocation before constructing the trace.
+    }
+
+    SVCommandBatch batch;
+    const auto& geometry = m_layout.geometry();
+    const auto steps = m_layout.columns_per_block_in_slice();
+    if (block_count == 0) {
+        return batch;
+    }
+
+    // Same allocation order as QK; only channels with valid KV participate.
+    // OrderedBlockMapper gives each participating channel a contiguous local
+    // block prefix, including sequentially filled growth channels.
+    std::vector<std::vector<PIMMACLocation>> channel_blocks(input.allocated_channel_ids.size());
+    for (std::uint64_t block = 0; block < block_count; ++block) {
+        const auto location = m_address_mapper.locate_mac(
+            KVKind::Value, input.layer_index, input.kv_head_index,
+            block, 0, input.allocated_channel_ids, input.initial_channel_count
+        );
+        const auto channel_it = std::find(
+            input.allocated_channel_ids.begin(), input.allocated_channel_ids.end(),
+            location.channel_id
+        );
+        const auto channel_index = static_cast<std::size_t>(
+            channel_it - input.allocated_channel_ids.begin()
+        );
+        channel_blocks[channel_index].push_back(location);
+    }
+    std::size_t maximum_local_blocks = 0;
+    for (std::size_t i = 0; i < channel_blocks.size(); ++i) {
+        if (!channel_blocks[i].empty()) {
+            batch.active_channel_ids.push_back(input.allocated_channel_ids[i]);
+            maximum_local_blocks = std::max(maximum_local_blocks, channel_blocks[i].size());
+        }
+    }
+
+    const auto append = [&batch](PIMOpcode opcode, std::uint64_t address) {
+        batch.commands.push_back(PIMCommand{opcode, address});
+    };
+    const auto barriers = [&](std::size_t begin) {
+        for (std::size_t i = 0; i < channel_blocks.size(); ++i) {
+            if (begin < channel_blocks[i].size()) {
+                append(PIMOpcode::Barrier, encode_channel(input.allocated_channel_ids[i]));
+            }
+        }
+    };
+    const auto weights_per_slot = static_cast<std::size_t>(m_layout.elements_per_column());
+    const auto resident_blocks = sv_input_slot_count * weights_per_slot; // 256.
+
+    const auto load_weights = [&](std::size_t begin, std::size_t count, bool streamed_only) {
+        const auto pages = count / weights_per_slot + (count % weights_per_slot != 0);
+        // Original context_cpvec(): rank -> BG -> slot -> channel.
+        for (std::uint64_t rank = 0; rank < geometry.ranks_per_pseudochannel; ++rank) {
+            for (std::uint64_t bg = 0; bg < geometry.bank_groups_per_rank; ++bg) {
+                for (std::size_t slot = 0; slot < pages; ++slot) {
+                    const auto first = begin + slot * weights_per_slot;
+                    for (std::size_t i = 0; i < channel_blocks.size(); ++i) {
+                        if (streamed_only && channel_blocks[i].size() <= resident_blocks) {
+                            continue; // This channel retained its complete input vector.
+                        }
+                        if (first >= channel_blocks[i].size()) {
+                            continue;
+                        }
+                        const auto channel = input.allocated_channel_ids[i];
+                        append(PIMOpcode::MoveGemvBuffer,
+                            encode_probability_buffer(channel, rank, bg,
+                                static_cast<std::uint64_t>(slot), value_base_row));
+                    }
+                }
+            }
+        }
+    };
+
+    const auto mac_blocks = [&](std::size_t begin, std::size_t count, std::uint64_t step) {
+        for (std::size_t offset = 0; offset < count; ++offset) {
+            const auto local = begin + offset;
+            for (std::size_t i = 0; i < channel_blocks.size(); ++i) {
+                if (local >= channel_blocks[i].size()) {
+                    continue;
+                }
+                auto location = channel_blocks[i][local];
+                location.column += step; // The mapper guarantees no block row crossing.
+                append(PIMOpcode::MacAllBank,
+                    m_encoder.encode_mac(location));
+            }
+        }
+    };
+
+    const auto collect_output = [&]() {
+        for (std::uint64_t bank = 0; bank < geometry.banks_per_bank_group; ++bank) {
+            for (std::uint64_t rank = 0; rank < geometry.ranks_per_pseudochannel; ++rank) {
+                for (std::size_t i = 0; i < channel_blocks.size(); ++i) {
+                    if (channel_blocks[i].empty()) {
+                        continue;
+                    }
+                    const auto channel = input.allocated_channel_ids[i];
+                    append(PIMOpcode::MoveSoftmaxBuffer,
+                        encode_context_buffer(channel, rank, bank, value_base_row));
+                }
+            }
+        }
+    };
+
+    // Separates the caller's preceding SFM commands from these input moves.
+    // Existing PIM_BARRIER is a scheduler boundary, not a new latency model.
+    barriers(0);
+    load_weights(0, std::min(resident_blocks, maximum_local_blocks), false);
+    barriers(0);
+    // Keep output dimensions fixed while accumulating contributions from
+    // all token blocks. Refilling inputs does not reset lane accumulators.
+    for (std::uint64_t step = 0; step < steps; ++step) {
+        for (std::size_t begin = 0; begin < maximum_local_blocks;) {
+            const auto count = std::min(resident_blocks, maximum_local_blocks - begin);
+            if (begin != 0 || (step != 0 && maximum_local_blocks > resident_blocks)) {
+                // Window zero is already resident on the first step. On later
+                // steps, reload it only on channels whose inputs did not fit.
+                load_weights(begin, count, begin == 0);
+                barriers(begin);
+            }
+            mac_blocks(begin, count, step);
+            barriers(begin); // Consume this window before reusing the slots.
+            begin += count;
+        }
+        collect_output();
+        barriers(0); // Collect this dimension step before reusing its accumulators.
+    }
+    return batch;
+}
+
+} // namespace Ramulator::TierRuntime
diff --git a/pim_ramulator_src/tier_runtime/tests/sv_commands_test.cpp b/pim_ramulator_src/tier_runtime/tests/sv_commands_test.cpp
new file mode 100644
--- /dev/null
+++ b/pim_ramulator_src/tier_runtime/tests/sv_commands_test.cpp
@@ -0,0 +1,208 @@
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <map>
+#include <stdexcept>
+#include <tuple>
+#include <vector>
+
+#include "pim_command_generator.h"
+
+using namespace Ramulator::TierRuntime;
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+template<class Function>
+void require_rejected(Function function) {
+    bool rejected = false;
+    try {
+        function();
+    } catch (const std::invalid_argument&) {
+        rejected = true;
+    } catch (const std::out_of_range&) {
+        rejected = true;
+    }
+    require(rejected, "invalid input must be rejected");
+}
+
+std::size_t count_commands(const SVCommandBatch& batch, PIMOpcode opcode,
+                           const AttAccAddressEncoder& encoder, int channel = -1) {
+    return static_cast<std::size_t>(std::count_if(batch.commands.begin(), batch.commands.end(),
+        [&](const PIMCommand& command) {
+            return command.opcode == opcode
+                && (channel < 0 || encoder.decode(command.address).channel_id == channel);
+        }));
+}
+
+// Check public commands using V element addresses, without production metadata.
+void verify(const RowAlignedKVLayout& layout, const OrderedBlockMapper& mapper,
+            const PIMCommandGenerator& generator, const SVCommandInput& input,
+            const std::vector<int>& active_channels) {
+    const auto batch = generator.generate_sv(input);
+    const AttAccAddressEncoder encoder(layout, 16);
+    const KVAddressMapper addresses(layout, mapper);
+    const auto steps = layout.columns_per_block_in_slice();
+    const auto base = layout.slice_base_row(KVKind::Value, input.layer_index, input.kv_head_index);
+    const auto block_size = layout.tokens_per_block();
+    const auto blocks = input.valid_token_count / block_size
+        + (input.valid_token_count % block_size != 0);
+    require(batch.active_channel_ids == active_channels, "active channels/allocation order");
+    if (blocks == 0) {
+        require(batch.commands.empty(), "empty SV emits no commands");
+        return;
+    }
+
+    std::map<std::uint64_t, std::uint64_t> expected_step;
+    std::map<std::uint64_t, unsigned> visits;
+    std::map<int, std::uint64_t> local_counts;
+    for (std::uint64_t block = 0; block < blocks; ++block) {
+        const auto placement = mapper.locate_block(block, input.allocated_channel_ids,
+                                                   input.initial_channel_count);
+        ++local_counts[placement.channel_id];
+        // One valid token per block exposes all dimension steps through the
+        // element mapper, including the partly occupied last block.
+        for (std::uint64_t d = 0; d < layout.shape().head_dimension(); ++d) {
+            const auto element = addresses.locate_element(
+                KVKind::Value, input.layer_index, input.kv_head_index, block * block_size, d,
+                input.allocated_channel_ids, input.initial_channel_count);
+            const auto address = encoder.encode_mac({element.channel_id, element.row, element.column});
+            expected_step[address] = layout.locate_dimension_partition(d).dimension_step;
+        }
+    }
+    require(expected_step.size() == blocks * steps, "distinct expected V transactions");
+
+    std::map<int, std::uint64_t> current_step, macs_in_step, outputs_in_step;
+    std::map<int, PIMOpcode> last_opcode;
+    std::map<int, bool> boundary;
+    std::map<std::tuple<int, std::uint64_t, std::uint64_t, std::uint64_t>, unsigned> outputs;
+    std::map<std::tuple<int, std::uint64_t, std::uint64_t, std::uint64_t>, unsigned> loaded_slots;
+    const auto output_packets = layout.geometry().banks_per_bank_group
+        * layout.geometry().ranks_per_pseudochannel;
+
+    for (const auto& command : batch.commands) {
+        const auto a = encoder.decode(command.address);
+        const auto channel = a.channel_id;
+        require(std::find(active_channels.begin(), active_channels.end(), channel)
+                != active_channels.end(), "no commands to an inactive channel");
+        if (command.opcode == PIMOpcode::Barrier) {
+            require(command.address == encoder.encode(AttAccAddressCoordinates{channel}),
+                    "canonical barrier address");
+            boundary[channel] = true;
+            continue;
+        }
+        require(last_opcode.count(channel) != 0 || boundary[channel], "initial stage boundary");
+        if (last_opcode.count(channel) == 0 || last_opcode[channel] != command.opcode) {
+            require(boundary[channel], "operation phases separated by barriers");
+        }
+        last_opcode[channel] = command.opcode;
+        boundary[channel] = false;
+        require(current_step[channel] < steps, "no operations after final output");
+
+        if (command.opcode == PIMOpcode::MoveGemvBuffer) {
+            require(outputs_in_step[channel] == 0, "no refill during output collection");
+            require(a.pseudochannel == 0 && a.bank == 0 && a.row == base && a.column == 0,
+                    "probability buffer address convention");
+            require(a.byte_offset_in_column < 16, "bounded raw input slot");
+            ++loaded_slots[{channel, a.rank, a.bank_group, a.byte_offset_in_column}];
+        } else if (command.opcode == PIMOpcode::MacAllBank) {
+            require(a.pseudochannel == 0 && a.rank == 0 && a.bank_group == 0
+                    && a.bank == 0 && a.byte_offset_in_column == 0, "MAC_AB broadcast address");
+            require(outputs_in_step[channel] == 0, "no MAC during output collection");
+            require(expected_step.at(command.address) == current_step[channel],
+                    "accumulate all tokens at one dimension step");
+            const auto local_block = (a.row - base) * layout.tiles_per_row()
+                + a.column / steps;
+            const auto slot = (local_block % 256) / 16;
+            for (std::uint64_t rank = 0; rank < layout.geometry().ranks_per_pseudochannel; ++rank) {
+                for (std::uint64_t bg = 0; bg < layout.geometry().bank_groups_per_rank; ++bg) {
+                    require(loaded_slots[{channel, rank, bg, slot}] != 0,
+                            "input slot loaded before MAC");
+                }
+            }
+            ++visits[command.address];
+            ++macs_in_step[channel];
+        } else if (command.opcode == PIMOpcode::MoveSoftmaxBuffer) {
+            require(macs_in_step[channel] == local_counts[channel],
+                    "collect after all local tokens in this dimension step");
+            require(a.pseudochannel == 0 && a.bank_group == 0 && a.row == base
+                    && a.column == 0 && a.byte_offset_in_column == 0,
+                    "context output address convention");
+            require(++outputs[{channel, current_step[channel], a.bank, a.rank}] == 1,
+                    "each bank/rank output collected once per dimension step");
+            if (++outputs_in_step[channel] == output_packets) {
+                ++current_step[channel];
+                outputs_in_step[channel] = 0;
+                macs_in_step[channel] = 0;
+            }
+        } else {
+            require(false, "unexpected SV operation");
+        }
+    }
+    for (const auto& [address, step] : expected_step) {
+        (void)step;
+        require(visits[address] == 1, "each V block/dimension step accessed exactly once");
+    }
+    for (const int channel : active_channels) {
+        require(current_step[channel] == steps && boundary[channel], "all output steps completed");
+    }
+}
+} // namespace
+
+int main() {
+    try {
+        const KVBlockShape shape({16, 2, 2, 128, 2});
+        const RowAlignedKVLayout layout(shape, {2, 2, 4, 4, 16384, 32, 32});
+        const KVCapacityModel capacity(layout);
+        const OrderedBlockMapper mapper(capacity);
+        const PIMCommandGenerator generator(layout, mapper, 16);
+        const AttAccAddressEncoder encoder(layout, 16);
+        for (const auto length : std::array<std::uint64_t, 10>{0, 1, 16, 17, 33, 34, 512, 513, 8192, 8193}) {
+            const auto channels = length == 0 ? std::vector<int>{}
+                : length <= 16 ? std::vector<int>{2} : std::vector<int>{2, 5};
+            verify(layout, mapper, generator, {0, 0, length, {2, 5, 9}, 2}, channels);
+        }
+        verify(layout, mapper, generator, {1, 1, 34, {5, 2}, 2}, {5, 2});
+        const auto sv = generator.generate_sv({0, 0, 34, {2, 5}, 2});
+        require(sv.commands.size() == 66
+                && count_commands(sv, PIMOpcode::MoveGemvBuffer, encoder) == 16
+                && count_commands(sv, PIMOpcode::MacAllBank, encoder) == 6
+                && count_commands(sv, PIMOpcode::MoveSoftmaxBuffer, encoder) == 32,
+                "34-token reference counts");
+        require(count_commands(generator.generate_sv({0, 0, 8192, {2, 5}, 2}),
+                               PIMOpcode::MoveGemvBuffer, encoder) == 256,
+                "resident inputs loaded once");
+        const auto spilled = generator.generate_sv({0, 0, 8193, {2, 5}, 2});
+        require(count_commands(spilled, PIMOpcode::MoveGemvBuffer, encoder) == 400
+                && count_commands(spilled, PIMOpcode::MoveGemvBuffer, encoder, 5) == 128,
+                "refills preserve cached channel inputs");
+
+        const RowAlignedKVLayout small(shape, {2, 2, 4, 4, 8, 32, 32});
+        const KVCapacityModel small_capacity(small);
+        const OrderedBlockMapper small_mapper(small_capacity);
+        const PIMCommandGenerator small_generator(small, small_mapper, 16);
+        verify(small, small_mapper, small_generator, {0, 0, 513, {2, 5, 9}, 2}, {2, 5, 9});
+        require_rejected([&] { (void)small_generator.generate_sv({0, 0, 513, {2, 5}, 2}); });
+        const KVBlockShape odd_shape({16, 2, 2, 65, 2});
+        const RowAlignedKVLayout odd(odd_shape, {2, 2, 4, 4, 16384, 32, 32});
+        const KVCapacityModel odd_capacity(odd);
+        const OrderedBlockMapper odd_mapper(odd_capacity);
+        const PIMCommandGenerator odd_generator(odd, odd_mapper, 16);
+        verify(odd, odd_mapper, odd_generator, {0, 0, 34, {2, 5}, 2}, {2, 5});
+        require_rejected([&] { (void)generator.generate_sv({0, 0, 1, {2, 2}, 2}); });
+        require_rejected([&] { (void)generator.generate_sv({0, 0, 1, {16}, 1}); });
+        require_rejected([&] { (void)generator.generate_sv({0, 0, 0, {2}, 0}); });
+        require_rejected([&] { (void)generator.generate_sv({2, 0, 0, {2}, 1}); });
+        require(generator.generate_qk({0, 0, 34, {2, 5}, 2}).commands.size() == 44,
+                "QK regression");
+        require(generator.generate_kv_append({0, 0, 33, {2, 5}, 2}).commands.size() == 16,
+                "append regression");
+        std::cout << "PASS: minimal SV API; V addresses, phase boundaries, refills, growth and QK/append regression\n";
+    } catch (const std::exception& error) {
+        std::cerr << "FAIL: " << error.what() << '\n';
+        return 1;
+    }
+}
