@@ -0,0 +1,101 @@
+#include <cstdint>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+#include "attacc_trace_writer.h"
+#include "pim_command_generator.h"
+
+using namespace Ramulator::TierRuntime;
+
+namespace {
+
+void require(bool condition, const char* message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+void verify_softmax(
+    const PIMCommandGenerator& generator,
+    const QKCommandBatch& qk,
+    const AttAccAddressEncoder& encoder,
+    const std::vector<int>& expected_channels
+) {
+    const auto commands = generator.generate_softmax(qk);
+    require(commands.size() == expected_channels.size(), "active channel count");
+    for (std::size_t i = 0; i < commands.size(); ++i) {
+        require(commands[i].opcode == PIMOpcode::Softmax, "SFM opcode");
+        const auto address = encoder.decode(commands[i].address);
+        require(address.channel_id == expected_channels[i], "channel order");
+        require(address.pseudochannel == 0 && address.rank == 0
+                && address.bank_group == 0 && address.bank == 0
+                && address.row == 0 && address.column == 0
+                && address.byte_offset_in_column == 0,
+                "canonical channel-scoped SFM address");
+    }
+}
+
+} // namespace
+
+int main() {
+    static_assert(static_cast<unsigned>(PIMOpcode::WriteGemvBuffer) == 0);
+    static_assert(static_cast<unsigned>(PIMOpcode::StoreFence) == 5);
+    static_assert(static_cast<unsigned>(PIMOpcode::Softmax) == 6);
+    static_assert(static_cast<unsigned>(PIMOpcode::MoveGemvBuffer) == 7);
+
+    const KVBlockShape shape({16, 2, 2, 128, 2});
+    const RowAlignedKVLayout layout(shape, {2, 2, 4, 4, 16384, 32, 32});
+    const KVCapacityModel capacity(layout);
+    const OrderedBlockMapper mapper(capacity);
+    const PIMCommandGenerator generator(layout, mapper, 16);
+    const AttAccAddressEncoder encoder(layout, 16);
+
+    const auto qk = generator.generate_qk({0, 0, 33, {2, 5}, 2});
+    require(qk.commands.size() == 44, "existing QK request count");
+    verify_softmax(generator, qk, encoder, {2, 5});
+    const auto softmax = generator.generate_softmax(qk);
+    require(softmax[0].address == 0x80000000ULL
+            && softmax[1].address == 0x140000000ULL, "fixture addresses");
+
+    std::ostringstream suffix;
+    AttAccTraceWriter::write(suffix, softmax);
+    require(suffix.str() == "PIM_SFM 0x80000000\nPIM_SFM 0x140000000\n",
+            "exact AttAcc SFM spelling and addresses");
+    std::ostringstream transfers;
+    AttAccTraceWriter::write(transfers, {
+        {PIMOpcode::MoveSoftmaxBuffer, 0x80000000ULL},
+        {PIMOpcode::MoveGemvBuffer, 0x80000000ULL},
+        {PIMOpcode::MemoryWrite, 0x80000000ULL},
+        {PIMOpcode::StoreFence, 0x80000000ULL}
+    });
+    require(transfers.str() == "PIM_MV_SB 0x80000000\nPIM_MV_GB 0x80000000\n"
+            "ST 0x80000000\nST_FENCE 0x80000000\n", "new and existing writer operations");
+
+    verify_softmax(generator, generator.generate_qk({0, 0, 1, {2, 5}, 2}), encoder, {2});
+    verify_softmax(generator, generator.generate_qk({0, 0, 0, {2, 5}, 2}), encoder, {});
+    verify_softmax(generator, generator.generate_qk({0, 0, 33, {5, 2}, 2}), encoder, {5, 2});
+    verify_softmax(generator, generator.generate_qk({0, 0, 33, {2, 5, 9}, 2}), encoder, {2, 5});
+    verify_softmax(generator, generator.generate_qk({1, 1, 34, {2, 5}, 2}), encoder, {2, 5});
+
+    const RowAlignedKVLayout small_layout(shape, {2, 2, 4, 4, 8, 32, 32});
+    const KVCapacityModel small_capacity(small_layout);
+    const OrderedBlockMapper small_mapper(small_capacity);
+    const PIMCommandGenerator small_generator(small_layout, small_mapper, 16);
+    const AttAccAddressEncoder small_encoder(small_layout, 16);
+    // Two original channels hold 512 tokens; token 513 uses growth channel 9.
+    verify_softmax(small_generator,
+        small_generator.generate_qk({0, 0, 513, {2, 5, 9}, 2}),
+        small_encoder, {2, 5, 9});
+
+    const auto append = generator.generate_kv_append({0, 0, 33, {2, 5}, 2});
+    require(append.commands.size() == 16 && append.key_write_count == 8
+            && append.value_write_count == 8 && append.channel_id == 2,
+            "KV append regression");
+
+    auto combined = qk.commands;
+    combined.insert(combined.end(), softmax.begin(), softmax.end());
+    require(combined.size() == 46 && qk.commands.size() == 44, "append without mutation");
+    std::cout << "PASS: SFM channels/addresses, writer, growth activation, QK and KV append regression\n";
+}
